generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum StatusCategory {
  BACKLOG
  UNSTARTED
  STARTED
  COMPLETED
}

enum Priority {
  URGENT
  HIGH
  MEDIUM
  LOW
  NONE
}

enum CycleStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  avatarColor  String   @default("#6366f1")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships    WorkspaceMember[]
  assignedIssues Issue[]           @relation("IssueAssignee")
  reportedIssues Issue[]           @relation("IssueReporter")
  comments       Comment[]
  activities     ActivityLog[]
  savedViews            SavedView[]
  apiKeys               ApiKey[]
  sentInvites           WorkspaceInvitation[] @relation("InvitedBy")
  timeEntries           TimeEntry[]
  notificationsReceived Notification[]        @relation("NotificationRecipient")
  notificationsSent     Notification[]        @relation("NotificationActor")
  ledProjects           Project[]             @relation("ProjectLead")
  projectUpdates        ProjectUpdate[]
}

model Workspace {
  id           String   @id @default(cuid())
  name         String
  slug         String   @unique
  issuePrefix  String   @default("SDG")
  issueCounter Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  members     WorkspaceMember[]
  invitations WorkspaceInvitation[]
  projects    Project[]
  statuses    WorkflowStatus[]
  labels      Label[]
  cycles      Cycle[]
  issues      Issue[]
  savedViews    SavedView[]
  apiKeys       ApiKey[]
  webhooks      Webhook[]
  notifications Notification[]
  templates     IssueTemplate[]
}

model WorkspaceInvitation {
  id          String        @id @default(cuid())
  workspaceId String
  email       String?
  role        WorkspaceRole @default(MEMBER)
  token       String        @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy User      @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@index([email])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  joinedAt    DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Project {
  id           String    @id @default(cuid())
  workspaceId  String
  name         String
  key          String
  summary      String    @default("")
  description  String    @default("")
  color        String    @default("#6366f1")
  status       String    @default("IN_PROGRESS")
  health       String    @default("NO_UPDATES")
  priority     Priority  @default(NONE)
  leadId       String?
  startDate    DateTime?
  targetDate   DateTime?
  resources    Json      @default("[]")
  issueCounter Int       @default(0)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  workspace  Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  lead       User?              @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)
  issues     Issue[]
  milestones ProjectMilestone[]
  updates    ProjectUpdate[]

  @@unique([workspaceId, key])
  @@index([workspaceId])
}

model ProjectMilestone {
  id          String    @id @default(cuid())
  projectId   String
  name        String
  description String    @default("")
  targetDate  DateTime?
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  issues  Issue[]

  @@index([projectId, position])
}

model ProjectUpdate {
  id        String   @id @default(cuid())
  projectId String
  authorId  String
  health    String   @default("ON_TRACK")
  body      String
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
}

model WorkflowStatus {
  id          String         @id @default(cuid())
  workspaceId String
  name        String
  slug        String
  category    StatusCategory
  color       String         @default("#71717a")
  position    Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issues    Issue[]

  @@unique([workspaceId, slug])
  @@index([workspaceId, position])
}

model Label {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  color       String   @default("#3b82f6")
  createdAt   DateTime @default(now())

  workspace Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issues    IssueLabel[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model Cycle {
  id          String      @id @default(cuid())
  workspaceId String
  name        String
  description String      @default("")
  startDate   DateTime
  endDate     DateTime
  status      CycleStatus @default(UPCOMING)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  issues    Issue[]

  @@index([workspaceId, status])
}

model Issue {
  id          String   @id @default(cuid())
  workspaceId String
  projectId   String
  number      Int
  identifier  String
  title       String
  description String   @default("")
  statusId    String
  priority    Priority @default(NONE)
  estimate    Int?
  assigneeId  String?
  reporterId  String?
  cycleId      String?
  milestoneId  String?
  parentId     String?
  sortOrder    Float    @default(0)
  customFields Json     @default("{}")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  workspace   Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status      WorkflowStatus    @relation(fields: [statusId], references: [id])
  assignee    User?             @relation("IssueAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  reporter    User?             @relation("IssueReporter", fields: [reporterId], references: [id], onDelete: SetNull)
  cycle       Cycle?            @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  milestone   ProjectMilestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  parent      Issue?            @relation("SubIssues", fields: [parentId], references: [id], onDelete: SetNull)
  subIssues   Issue[]        @relation("SubIssues")
  labels      IssueLabel[]
  comments      Comment[]
  activities    ActivityLog[]
  timeEntries   TimeEntry[]
  notifications Notification[]

  @@unique([workspaceId, identifier])
  @@index([workspaceId, statusId])
  @@index([workspaceId, cycleId])
  @@index([workspaceId, assigneeId])
  @@index([workspaceId, projectId])
  @@index([workspaceId, updatedAt])
  @@index([parentId])
}

model IssueLabel {
  issueId String
  labelId String

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  label Label @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([issueId, labelId])
}

model Comment {
  id        String   @id @default(cuid())
  issueId   String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  issue  Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  author User  @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([issueId, createdAt])
}

model TimeEntry {
  id              String    @id @default(cuid())
  issueId         String
  userId          String
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  durationSeconds Int       @default(0)
  stage           String    @default("")
  note            String    @default("")
  isManual        Boolean   @default(false)
  createdAt       DateTime  @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([issueId, createdAt])
  @@index([userId, endedAt])
}

model ActivityLog {
  id        String   @id @default(cuid())
  issueId   String
  actorId   String?
  actorName String
  action    String
  field     String?
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())

  issue Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([issueId, createdAt])
}

model SavedView {
  id            String   @id @default(cuid())
  workspaceId   String
  ownerId       String
  name          String
  description   String   @default("")
  isShared      Boolean  @default(true)
  filters       Json     @default("{}")
  displayConfig Json     @default("{}")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  owner     User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model ApiKey {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  keyPrefix   String
  keyHash     String    @unique
  createdById String
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model Webhook {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  url         String
  secret      String
  events      String[]
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([workspaceId])
}

model WebhookDelivery {
  id         String   @id @default(cuid())
  webhookId  String
  event      String
  statusCode Int?
  success    Boolean
  error      String?
  payload    Json
  createdAt  DateTime @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
}

model Notification {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  actorId     String?
  issueId     String?
  type        String    @default("MENTION")
  title       String
  body        String    @default("")
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user      User      @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor     User?     @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  issue     Issue?    @relation(fields: [issueId], references: [id], onDelete: Cascade)

  @@index([userId, workspaceId, readAt])
  @@index([userId, createdAt])
}

model IssueTemplate {
  id          String   @id @default(cuid())
  workspaceId String
  name        String
  description String   @default("")
  content     String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}
