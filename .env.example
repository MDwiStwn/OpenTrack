# PostgreSQL connection string
DATABASE_URL="postgresql://opentrack:opentrack_secret@localhost:5432/opentrack?schema=public"

# Session encryption secret (REQUIRED in production - generate with: openssl rand -hex 32)
JWT_SECRET="replace-with-openssl-rand-hex-32-minimum-32-characters"

# Session token lifetime (e.g., 12h, 24h, 7d)
JWT_EXPIRES_IN="24h"

# Set to "true" when serving over HTTPS in production
COOKIE_SECURE="false"

# Keep "false" for a clean fresh workspace setup; set "true" only for local demo seed data
SEED_DATABASE="false"

NEXT_PUBLIC_APP_NAME="OpenTrack"
